# Copy outside the repository, or use init-env.py to generate a private file.
# APP_DB_PASSWORD must contain only hexadecimal characters (generated automatically).
POSTGRES_PASSWORD=
MARIADB_ROOT_PASSWORD=
APP_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Optional overrides. The old infra/docker-compose stack uses different ports/volumes.
IMAGE_REGISTRY=sinhan_project
IMAGE_TAG=local
APP_MEMORY_LIMIT=384m
POSTGRES_PORT=35432
MARIADB_PORT=33306
REDIS_HOST_PORT=36379
KAFKA_HOST_PORT=39092

# Optional future client endpoints; adapters still need to bind pg.clients.*.base-url.
# LEDGER_BASE_URL=http://ledger:8083
# FEP_BASE_URL=http://fep-adapter:8091
# AI_GATEWAY_BASE_URL=http://ai-gateway:8090

# Required for MVP1 internal account/OTP checks; generate or add with init-env.py --upgrade.
INTERNAL_SERVICE_TOKEN=
AUTH_OTP_SECRET_HEX=
